# Plantilla de variables de entorno para Ready Match
# Copia este archivo como ".env" y completa tus propios valores locales.

# Clave secreta de sesiones Flask (genera una cadena larga y aleatoria)
SECRET_KEY=cambia_esta_clave_por_una_cadena_larga_aleatoria

# Código requerido para registrar cuentas de administradores de canchas
CODIGO_ADMIN_RM=define_tu_codigo_de_administrador

# Modo depuración de Flask (0 = desactivado por defecto, 1 = desarrollo)
FLASK_DEBUG=0

# Opcional: correo Gmail y contraseña de aplicación para recuperación de contraseña
CORREO_APP=tu_correo@gmail.com
CLAVE_CORREO_APP=tu_clave_de_aplicacion_gmail
